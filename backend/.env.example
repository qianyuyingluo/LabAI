# Copy to .env and configure your own model service. Never commit .env.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_DEFAULT_MODEL=
OPENAI_COMPAT_SUPPORTS_STREAM=true
OPENAI_COMPAT_SUPPORTS_VISION=false

# Files are parsed locally. Excerpts are sent to the configured model during chat.
MAX_IMAGE_UPLOAD_MB=10
MAX_FILE_UPLOAD_MB=25
MAX_FILES_SKILL_CONTEXT_CHARS=60000
FILES_SKILL_PREVIEW_CHARS=4000
FILES_SKILL_UPLOAD_SUMMARY_CHARS=12000
FILE_PARSE_TIMEOUT_SECONDS=45
FILE_PARSE_MAX_CONCURRENT=2
DOCUMENT_MAX_TOOL_CALLS=12

# Bound workspace agent: per attempt tool budget and approximate context budget.
AGENT_MAX_TOOL_CALLS=60
AGENT_CONTEXT_CHARS=120000

# npm start supplies LABAI_SANDBOX_PYTHON automatically.
SANDBOX_TIMEOUT_SECONDS=90
SANDBOX_MAX_TOOL_CALLS=6
SANDBOX_NETWORK_ENABLED=false
